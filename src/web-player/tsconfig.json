{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "allowJs": true,

    "paths": {
      "@polyzone/runtime": ["../runtime/src/index"],
      "@polyzone/runtime/*": ["../runtime/src/*"],
      "@polyzone/core": ["../core/src/index"],
      "@polyzone/core/*": ["../core/src/*"],
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
  },
  "include": [
    "eslint.config.mjs",
    "vite.config.ts",
    "src/**/*.ts",
  ],
}
