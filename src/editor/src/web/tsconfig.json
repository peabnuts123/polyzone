{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true, // Disappointing 😔
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "jsx": "preserve",
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@app/*": ["./src/*"],
      "@lib/*": ["./lib/*"],
      "@test/*": ["./test/*"],
      "@polyzone/core": ["../../../core/src"],
      "@polyzone/core/*": ["../../../core/src/*"],
      "@polyzone/runtime": ["../../../runtime/src"],
      "@polyzone/runtime/*": ["../../../runtime/src/*"],
    },
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "vitest.config.ts",
    "postcss.config.js",
  ],
  "exclude": [
    "../../../../node_modules",
    "../../node_modules",
    "public",
    "dist",
    "test/integration/mock/assets/scripts/*"
  ]
}
