{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "stripInternal": true,
    "allowJs": true,

    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "module": "ESNext",

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "skipLibCheck": true, // Fucks sake, TypeScript: https://github.com/microsoft/TypeScript/issues/40426
    "strict": true,
  },
  "include": [
    "eslint.config.mjs",
    "src/**/*.ts",
    "vitest.config.ts",
  ],
}
